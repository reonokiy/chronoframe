# PostgreSQL is required in development and production.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/chronoframe

# Generate a random value of at least 32 characters. Supply using a Secret.
NUXT_SESSION_PASSWORD=

# Register this exact callback in the OIDC provider (Pocket ID compatible).
NUXT_OIDC_ISSUER=
NUXT_OIDC_CLIENT_ID=
NUXT_OIDC_CLIENT_SECRET=
NUXT_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
# Comma-separated OIDC sub claims. No automatic first-user administrator.
NUXT_OIDC_ALLOWED_SUBJECTS=
NUXT_PUBLIC_OIDC_LABEL=Single sign-on
NUXT_PUBLIC_GALLERY_PUBLIC=false

# Development defaults to local; production defaults to and requires s3.
NUXT_STORAGE_DRIVER=
NUXT_STORAGE_LOCAL_PATH=./data/storage
NUXT_STORAGE_PREFIX=photos
NUXT_STORAGE_S3_ENDPOINT=
NUXT_STORAGE_S3_BUCKET=
NUXT_STORAGE_S3_REGION=auto
NUXT_STORAGE_S3_ACCESS_KEY_ID=
NUXT_STORAGE_S3_SECRET_ACCESS_KEY=
NUXT_STORAGE_S3_FORCE_PATH_STYLE=false
CFRAME_WORKER_COUNT=2
